{
  "manifestVersion": 2,
  "id": "hanako-simple-player",
  "name": "小花音乐播放器",
  "version": "1.2.2",
  "description": "网易云 / B站 / QQ / 酷狗四源开箱即用；交给 Hana：敲 /mood 按心情选歌建单，也能让它把 B站歌单整理成带网易云歌词与封面的歌单；随音乐起伏的指针涟漪；跟随 Hana 主题与承载形态自适应，符合 Hana 美学；基于上游 openhanako-audio-player 的极简重构衍生版。",
  "minAppVersion": "0.1017.0",
  "entry": "index.js",
  "icon": "assets/icon.png",
  "capabilities": [
    "app/tools.expose-to-model",
    "app/ui.clipboard-write",
    "app/ui.open-external",
    "app/resources.read",
    "app/sessions.read",
    "app/session.start-turn",
    "app/sessions.manage"
  ],
  "network": {
    "allowedHosts": [
      "metingapi.nanorocky.top",
      "api.amarea.cn",
      "api.qijieya.cn",
      "met.liiiu.cn",
      "music.163.com",
      "amll-ttml-db.stevexmh.net",
      "*.music.126.net",
      "u.y.qq.com",
      "api.bilibili.com",
      "*.hdslb.com",
      "*.bilivideo.cn",
      "*.bilivideo.com",
      "*.mountaintoys.cn"
    ],
    "methods": [
      "GET"
    ],
    "allowLocalhost": false,
    "defaultTimeoutMs": 15000,
    "maxResponseBytes": 5242880
  },
  "contributes": {
    "cards": [
      {
        "id": "player",
        "title": "小花音乐播放器",
        "description": "播放当前曲目、查看队列与歌词。",
        "route": "/index.html",
        "face": {
          "image": "face-portrait.png"
        },
        "cardForm": "edge-to-edge",
        "titleMode": "hide",
        "detached": {
          "route": "/standalone.html"
        },
        "detachedDefaultSize": {
          "width": 1040,
          "height": 780
        }
      }
    ],
    "messageRenderers": [
      {
        "customType": "now-playing",
        "cardId": "player"
      }
    ]
  }
}
