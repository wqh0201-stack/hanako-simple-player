{
  "manifestVersion": 2,
  "id": "hanako-simple-player",
  "name": "小花音乐播放器",
  "version": "1.0.4",
  "description": "小花音乐播放器（极简重构版）：本地音乐与在线音乐播放，含歌词横幅、环境色背景、歌词/频谱两态与指针涟漪。基于上游 openhanako-labs/openhanako-audio-player 的极简重构 fork。",
  "minAppVersion": "0.1017.0",
  "entry": "index.js",
  "icon": "assets/icon.png",
  "capabilities": [
    "app/tools.expose-to-model",
    "app/ui.clipboard-write",
    "app/ui.open-external",
    "app/resources.read",
    "app/sessions.read"
  ],
  "network": {
    "allowedHosts": [
      "metingapi.nanorocky.top",
      "api.amarea.cn",
      "api.qijieya.cn",
      "met.liiiu.cn",
      "music.163.com",
      "amll-ttml-db.stevexmh.net",
      "*.music.126.net",
      "u.y.qq.com",
      "api.bilibili.com",
      "*.hdslb.com",
      "*.bilivideo.cn",
      "*.bilivideo.com",
      "*.mountaintoys.cn"
    ],
    "methods": [
      "GET"
    ],
    "allowLocalhost": false,
    "defaultTimeoutMs": 15000,
    "maxResponseBytes": 5242880
  },
  "contributes": {
    "cards": [
      {
        "id": "player",
        "title": "小花音乐播放器",
        "description": "播放当前曲目、查看队列与歌词。",
        "route": "/index.html",
        "face": {
          "image": "face-portrait.png"
        },
        "cardForm": "edge-to-edge",
        "titleMode": "hide",
        "detached": {
          "route": "/standalone.html"
        },
        "detachedDefaultSize": {
          "width": 1040,
          "height": 780
        }
      }
    ],
    "messageRenderers": [
      {
        "customType": "now-playing",
        "cardId": "player"
      }
    ]
  }
}
